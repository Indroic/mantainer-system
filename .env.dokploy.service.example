#################################################################################
#                  .env.dokploy.service.example (NIVEL SERVICIO)               #
#                                                                               #
#  Instrucciones: Copia y pega el bloque correspondiente a cada servicio en la  #
#  pestaña de "Environment Variables" de cada contenedor respectivo en Dokploy. #
#  Todas las credenciales y URLs de conexión a Postgres se manejan de forma     #
#  centralizada y privada a través de la red dokploy-network.                   #
#################################################################################


# ===============================================================================
# 1. SERVICIO: web (Frontend + Proxy Nginx)  <- UNICO servicio con dominio publico
# ===============================================================================
# Es el unico que debe tener un dominio asignado en Dokploy (https://sgmm.indroic.dev).
# nginx hace de proxy inverso hacia auth-server y backend por la red dokploy-network.
# No requiere variables: las URLs estan hardcodeadas al mismo origen en el codigo.


# ===============================================================================
# 2. SERVICIO: auth-server (Servidor Hono/Better Auth - Node)  <- SOLO interno
# ===============================================================================
# NO le asignes dominio publico en Dokploy; se alcanza via el proxy de `web`.
PORT=3000
NODE_ENV=production

# Hereda los secretos y urls globales del proyecto en Dokploy
BETTER_AUTH_SECRET={{project.BETTER_AUTH_SECRET}}
BETTER_AUTH_URL={{project.BETTER_AUTH_URL}}

# --- Envio de correo (recuperacion de contrasena por codigo de 6 digitos) ---
# Necesario para que el flujo "Olvide mi contrasena" entregue el codigo OTP.
# Sin RESEND_API_KEY el sistema NO envia el correo: registra el codigo en el log
# del contenedor auth-server (util en desarrollo, inaceptable en produccion).
RESEND_API_KEY={{project.RESEND_API_KEY}}
MAIL_FROM={{project.MAIL_FROM}}


# ===============================================================================
# 3. SERVICIO: backend (API REST FastAPI - Python)  <- SOLO interno
# ===============================================================================
# NO le asignes dominio publico en Dokploy; se alcanza via el proxy de `web`
# (https://sgmm.indroic.dev/api/*). Valida el JWT contra el JWKS interno del auth.
PORT=8000

# Hereda la configuración interna de comunicación con el auth server
BETTER_AUTH_URL={{project.BETTER_AUTH_URL_INTERNAL}}
JWKS_URL={{project.JWKS_URL}}
