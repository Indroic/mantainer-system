FROM node:22-alpine
RUN apk add --no-cache libc6-compat

WORKDIR /app

# El script de migración (scripts/migrate-auth.mjs) sólo depende de `pg`.
# NO instalamos el workspace completo: el Dockerfile anterior copiaba únicamente
# `packages/` y ejecutaba `pnpm install --frozen-lockfile`, pero el lockfile
# incluye importers para `apps/server` y `apps/web` (ausentes en el contexto),
# así que pnpm fallaba con ERR_PNPM_OUTDATED_LOCKFILE y la imagen nunca llegaba
# a crear las tablas de Better Auth (incluida `jwks`).
#
# Instalamos pg de forma aislada y copiamos sólo el script: build rápido y
# reproducible, sin acoplarnos al estado del monorepo.
RUN npm install --no-save pg@^8.17.1

COPY packages/db/scripts/migrate-auth.mjs ./migrate-auth.mjs

# Aplica DDL idempotente EXCLUSIVAMENTE sobre las tablas de Better Auth
# (user/session/account/verification/jwks). No toca las tablas de Alembic.
CMD ["node", "migrate-auth.mjs"]
