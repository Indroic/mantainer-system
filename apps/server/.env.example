# Puerto de escucha local
PORT=3000
NODE_ENV=production

# Base de datos de infraestructura (Postgres)
# En Dokploy, usa las credenciales del contenedor postgres:
# postgresql://<user>:<password>@postgres:5432/<db_name>
DATABASE_URL=postgresql://postgres:postgres_secure_password@postgres:5432/sgmm_auth_db

# Clave secreta para Better Auth (mínimo 32 caracteres aleatorios)
BETTER_AUTH_SECRET=generar_clave_secreta_de_minimo_32_caracteres_aqui

# URL pública PROPIA del servidor de Better Auth (su propio subdominio),
# NO la de la web. Debe coincidir con el host donde se sirve este servidor.
# Ejemplo: https://authsgmm.tuservidor.com
BETTER_AUTH_URL=https://authsgmm.tuservidor.com

# Origen(es) permitido(s) para CORS = el/los dominio(s) de la web.
# Admite varios separados por coma. Ejemplo: https://sgmm.tuservidor.com
CORS_ORIGIN=https://sgmm.tuservidor.com

# (Opcional) Dominio padre compartido para que la cookie de sesión funcione
# entre subdominios (web y auth). Debe empezar con punto. Ejemplo: .tuservidor.com
# Si la web y el auth están en el MISMO dominio, deja esta variable vacía.
COOKIE_DOMAIN=.tuservidor.com
