# Puerto de escucha local
PORT=3000
NODE_ENV=production

# Base de datos de infraestructura (Postgres)
# En Dokploy, usa las credenciales del contenedor postgres:
# postgresql://<user>:<password>@postgres:5432/<db_name>
DATABASE_URL=postgresql://postgres:postgres_secure_password@postgres:5432/sgmm_auth_db

# Clave secreta para Better Auth (mínimo 32 caracteres aleatorios)
BETTER_AUTH_SECRET=generar_clave_secreta_de_minimo_32_caracteres_aqui

# Topología SINGLE-ORIGIN: este servidor NO se expone con dominio propio. El
# navegador lo alcanza a través del proxy inverso de la web en
# https://sgmm.indroic.dev/api/auth/* (y /trpc/*, /create-admin).
# Por eso la URL pública de Better Auth es la de la web. Está hardcodeada en
# packages/auth/src/index.ts; esta variable queda informativa.
BETTER_AUTH_URL=https://sgmm.tuservidor.com
