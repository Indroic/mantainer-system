# Puerto de escucha local
PORT=8000

# Base de datos PostgreSQL (OBLIGATORIO).
# Única fuente de verdad: config.py deriva de aquí las URLs síncrona (Alembic)
# y asíncrona (asyncpg) automáticamente.
DATABASE_URL=postgresql://postgres:postgres_secure_password@postgres:5432/sgmm_auth_db

# URL del servidor de autenticación de Better Auth
# En la red Dokploy, apunta al nombre de host del contenedor de autenticación
BETTER_AUTH_URL=http://auth-server:3000
JWKS_URL=http://auth-server:3000/api/auth/jwks

# Si ejecutas el backend fuera de Dokploy, cambia estos valores por la URL pública
# del servicio de auth y su JWKS correspondiente.
