# URL pública que usa el navegador para hablar con el servidor de auth
# En Dokploy, apunta al dominio público de la web
# Ejemplo: https://sgmm.tuservidor.com
VITE_AUTH_URL=https://sgmm.tuservidor.com

# URL interna de la API FastAPI para SSR o ejecución server-side
# En Dokploy, apunta al nombre del servicio dentro de la red Docker
# Ejemplo: http://backend:8000
VITE_API_URL=http://backend:8000
