# Topología SINGLE-ORIGIN: el navegador habla con TODO (web, auth y API) a través
# del mismo dominio, gracias al proxy inverso de nginx (apps/web/nginx.conf):
#   http://localhost:80/api/auth/*  -> auth-server (Better Auth)
#   http://localhost:80/trpc/*      -> auth-server (tRPC)
#   http://localhost:80/api/*       -> backend (FastAPI)
#
# Las URLs están HARDCODEADAS al mismo origen en el código (apps/web/src/lib,
# apps/web/src/router.tsx, packages/auth). Estas variables NO se usan en runtime;
# si migras de dominio, edítalas directamente en el código.
VITE_AUTH_URL=http://localhost:80
VITE_API_URL=http://localhost:80
