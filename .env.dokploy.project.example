#################################################################################
#                  .env.dokploy.project.example (NIVEL PROYECTO)                #
#                                                                               #
#  Instrucciones: Copia este bloque de variables y pégalo en la sección de      #
#  "Environment Variables" de tu PROYECTO principal en Dokploy. Estas variables #
#  serán compartidas y heredadas por todos los servicios dentro de tu stack.    #
#################################################################################

# ----------------- CONFIGURACIÓN GLOBAL DE SEGURIDAD -----------------
# Genera una clave secreta aleatoria de al menos 32 caracteres (puedes usar openssl rand -hex 32)
BETTER_AUTH_SECRET=df8374a2b918fcd3e5719365bc920c8de817f5492bc394a108de92bc8172fa8b

# ----------------- DOMINIO Y RUTEO PÚBLICO (PROXY INVERSO / SINGLE-ORIGIN) -----
# Topología single-origin: SOLO el servicio `web` se expone públicamente en
# Dokploy (un único dominio). nginx (en el contenedor web) hace de proxy inverso:
#   https://sgmm.indroic.dev/api/auth/*   -> auth-server
#   https://sgmm.indroic.dev/trpc/*       -> auth-server
#   https://sgmm.indroic.dev/create-admin -> auth-server
#   https://sgmm.indroic.dev/api/*        -> backend (FastAPI)
# Los servicios auth-server y backend NO necesitan dominio público propio.
# Así desaparecen los problemas de CORS y de cookies cross-subdominio.
#
# Nota: las URLs del frontend y de Better Auth están HARDCODEADAS a
# https://sgmm.indroic.dev en el código (apps/web/src/lib, packages/auth).
# Si cambias de dominio, actualízalas allí. Esta variable queda informativa.
BETTER_AUTH_URL=https://sgmm.indroic.dev

# ----------------- CREDENCIALES DE BASE DE DATOS (POSTGRES) -----------------
# FUENTE DE VERDAD ÚNICA. Estos valores los usan TODOS los servicios:
#   - postgres (infra), auth-server, auth-migrate, backend y backend-migrate.
# Las URLs de conexión deben usar EXACTAMENTE el mismo usuario/clave/host/db.
# Cámbialos a tu gusto, pero manténlos idénticos en todos lados (el host es el
# nombre del contenedor: `postgres`).
#
# ⚠️ POSTGRES_PASSWORD solo se aplica al CREAR el volumen por primera vez. Si el
# volumen ya existe con otra clave, este valor NO la cambia: o reseteas la clave
# (ALTER USER) o recreas el volumen `sgmm_postgres_data`.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=sgmm_auth_db

# Better Auth (Node/drizzle) — debe coincidir con POSTGRES_* de arriba.
DATABASE_URL=postgresql://postgres:postgres_secure_password@postgres:5432/sgmm_auth_db

# Backend FastAPI (SQLAlchemy) — misma DB, sync y async. Deben coincidir también.
SQL_DATABASE_URL=postgresql://postgres:postgres_secure_password@postgres:5432/sgmm_auth_db
ASYNC_SQL_DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_password@postgres:5432/sgmm_auth_db

# ----------------- CONFIGURACIÓN DE RUTAS INTERNAS (DOCKER) -----------------
# Comunicación interna del backend con el servidor de auth (red dokploy-network).
BETTER_AUTH_URL_INTERNAL=http://auth-server:3000
JWKS_URL=http://auth-server:3000/api/auth/jwks
