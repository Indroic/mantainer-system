#################################################################################
#                  .env.dokploy.project.example (NIVEL PROYECTO)                #
#                                                                               #
#  Instrucciones: Copia este bloque de variables y pégalo en la sección de      #
#  "Environment Variables" de tu PROYECTO principal en Dokploy. Estas variables #
#  serán compartidas y heredadas por todos los servicios dentro de tu stack.    #
#################################################################################

# ----------------- CONFIGURACIÓN GLOBAL DE SEGURIDAD -----------------
# Genera una clave secreta aleatoria de al menos 32 caracteres (puedes usar openssl rand -hex 32)
BETTER_AUTH_SECRET=df8374a2b918fcd3e5719365bc920c8de817f5492bc394a108de92bc8172fa8b

# ----------------- DOMINIO Y RUTEO PÚBLICO (PROXY) -----------------
# Dominio público del frontend web
VITE_AUTH_URL=https://authsgmm.indroic.dev
VITE_API_URL=https://apisgmm.indroic.dev

# Dominio público expuesto por el servidor de Better Auth
BETTER_AUTH_URL=https://authsgmm.indroic.dev

# Origen permitido para las peticiones del navegador hacia auth
# (admite varios dominios separados por coma)
CORS_ORIGIN=https://sgmm.indroic.dev

# Dominio padre compartido para que la cookie de sesión de Better Auth se
# comparta entre subdominios (web sgmm.* y auth authsgmm.*). Debe empezar con punto.
COOKIE_DOMAIN=.indroic.dev

# ----------------- CREDENCIALES DE BASE DE DATOS (POSTGRES) -----------------
# Estas credenciales las heredará el servicio de base de datos Postgres de infraestructura
# y el servidor de Better Auth para iniciar la conexión.
POSTGRES_USER=dokploy_postgres_admin
POSTGRES_PASSWORD=postgres_secure_db_password_change_me_1234
POSTGRES_DB=sgmm_auth_db
DATABASE_URL=postgresql://dokploy_postgres_admin:postgres_secure_db_password_change_me_1234@postgres:5432/sgmm_auth_db

# ----------------- CONFIGURACIÓN DE RUTAS INTERNAS (DOCKER) -----------------
# Configuración del backend FastAPI para comunicarse con el servidor de autenticación
# en la red privada puente 'dokploy-network'.
BETTER_AUTH_URL_INTERNAL=http://auth-server:3000
JWKS_URL=http://auth-server:3000/api/auth/jwks
